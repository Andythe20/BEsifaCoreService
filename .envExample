# Renombra este archivo a .env y completa las variables de entorno correctamente. Este archivo no debe ser subido a repositorios públicos ya que contiene información sensible.

# ============================================
# DATABASE
# ============================================
DB_HOST=localhost
DB_PORT=3306
DB_NAME_CORE=nombre_de_tu_base_de_datos
DB_USER=usuario_de_tu_base_de_datos
DB_PASSWORD=password_de_tu_base_de_datos

# ============================================
# JWT
# ============================================
# Secreto y claims del token interno X-Auth-Identity que emite el gateway.
# Deben coincidir con los de BEsifaAPIGateway y BEsifaAuthService.
INTERNAL_JWT_SECRET=llave_segura
INTERNAL_JWT_ISSUER=sifa-gateway
INTERNAL_JWT_AUDIENCE=sifa-core

# ============================================
# CANAL INTERNO
# ============================================
# Firma que el gateway adjunta en X-Internal-Key y que ChannelKeyFilter exige
# en toda petición. Idéntica en gateway, auth, core y plate.
# Vacío = guardia desactivada.
INTERNAL_CHANNEL_KEY=clave_compartida_con_los_servicios

# ============================================
# AWS S3 CONFIGURATION
# ============================================
# Nombre del bucket de S3 donde se almacenarán los archivos
AWS_S3_BUCKET_NAME=mi-bucket

# Región del bucket de S3
AWS_S3_REGION=us-east-1

# ============================================
# APP
# ============================================
SERVER_PORT=8083

# ============================================
# FIREBASE CREDENTIALS
# ============================================
FIREBASE_CREDENTIALS='JSON_CREDENCIAL'